{
	"name": "mini-merge-checks",
	"target": "branch",
	"enforcement": "active",
	"bypass_actors": [],
	"conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
	"rules": [
		{
			"type": "required_status_checks",
			"parameters": {
				"strict_required_status_checks_policy": true,
				"required_status_checks": [
					{ "context": "compile-and-smoke-test (ubuntu-latest, bun-linux-x64-baseline)", "integration_id": 15368 },
					{ "context": "compile-and-smoke-test (macos-latest, bun-darwin-x64)", "integration_id": 15368 },
					{ "context": "compile-and-smoke-test (windows-latest, bun-windows-x64-baseline)", "integration_id": 15368 },
					{ "context": "lint-and-unit-test (ubuntu-latest)", "integration_id": 15368 },
					{ "context": "lint-and-unit-test (macos-latest)", "integration_id": 15368 },
					{ "context": "lint-and-unit-test (windows-latest)", "integration_id": 15368 },
					{ "context": "nix-package", "integration_id": 15368 }
				]
			}
		},
		{
			"type": "pull_request",
			"parameters": {
				"allowed_merge_methods": ["merge"],
				"dismiss_stale_reviews_on_push": false,
				"require_code_owner_review": false,
				"require_last_push_approval": false,
				"required_approving_review_count": 0,
				"required_review_thread_resolution": false
			}
		}
	]
}
